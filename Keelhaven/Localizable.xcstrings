{
  "sourceLanguage": "en",
  "strings": {
    "%@ finished successfully.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已成功完成备份。"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %@"
          }
        }
      }
    },
    "%@, selected as backup drive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已选为备份硬盘"
          }
        }
      }
    },
    "%@, selected for backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已选择备份"
          }
        }
      }
    },
    "%@: %lld new files, %@ added.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：新增 %2$lld 个文件，共 %3$@。"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. %2$@"
          }
        }
      }
    },
    "A password is required to encrypt the backup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要设置密码来加密备份"
          }
        }
      }
    },
    "About Keelhaven": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Keelhaven"
          }
        }
      }
    },
    "Access key ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Key ID"
          }
        }
      }
    },
    "Actions for %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的操作"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add Backup Plan…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备份计划…"
          }
        }
      }
    },
    "Add Folders…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加文件夹…"
          }
        }
      }
    },
    "Add at least one folder to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加至少一个文件夹后继续"
          }
        }
      }
    },
    "Advanced options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级选项"
          }
        }
      }
    },
    "All fields are required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有字段均为必填"
          }
        }
      }
    },
    "All fields except the path prefix are required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除路径前缀外均为必填"
          }
        }
      }
    },
    "Another plan already backs up to this destination. Connect to its repository under Advanced options, or pick a different folder or bucket path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有其他计划备份到这个位置了。可以在“高级选项”里接入它的仓库，或者换一个位置。"
          }
        }
      }
    },
    "At": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "Back Up Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即备份"
          }
        }
      }
    },
    "Back up %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份%@"
          }
        }
      }
    },
    "Back up to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份到 %@"
          }
        }
      }
    },
    "Backed up": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已备份"
          }
        }
      }
    },
    "Backed up %@ ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前完成备份"
          }
        }
      }
    },
    "Backed up on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已于 %@ 完成备份"
          }
        }
      }
    },
    "Backup %lld percent done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已完成 %lld%%"
          }
        }
      }
    },
    "Backup complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份完成"
          }
        }
      }
    },
    "Backup failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份失败"
          }
        }
      }
    },
    "Backup in progress": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份进行中"
          }
        }
      }
    },
    "Backup running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在备份"
          }
        }
      }
    },
    "Backups are encrypted before leaving your Mac. This password is stored in your Keychain — without it, backups cannot be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份在离开您的 Mac 之前就已加密。密码保存在钥匙串里——没有它就无法恢复备份。"
          }
        }
      }
    },
    "Bucket": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储桶"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取"
          }
        }
      }
    },
    "Choose a destination folder to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择备份目标文件夹后继续"
          }
        }
      }
    },
    "Choose a point in time. Files are restored into a new folder — nothing is overwritten.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个时间点。文件会恢复到一个新文件夹里，不会覆盖任何现有文件。"
          }
        }
      }
    },
    "Choose the folders to back up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要备份的文件夹。"
          }
        }
      }
    },
    "Choose where to put the restored files. Keelhaven creates a new subfolder — existing files are never touched.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择恢复文件的存放位置。Keelhaven 会新建一个子文件夹，绝不会动您现有的文件。"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取…"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Confirm password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再输一遍密码"
          }
        }
      }
    },
    "Connect to an existing repository at this destination": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入该位置上已有的备份仓库"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝"
          }
        }
      }
    },
    "Copy Repository Password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝备份密码"
          }
        }
      }
    },
    "Copy Version Info": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝版本信息"
          }
        }
      }
    },
    "Could not load backup plans: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取备份计划：%@"
          }
        }
      }
    },
    "Create Backup Plan": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建备份计划"
          }
        }
      }
    },
    "Creating Repository…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在创建备份仓库…"
          }
        }
      }
    },
    "Daily at %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 %@"
          }
        }
      }
    },
    "Date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Delete Backup Plan…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除备份计划…"
          }
        }
      }
    },
    "Delete “%@”?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除“%@”吗？"
          }
        }
      }
    },
    "Desktop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面"
          }
        }
      }
    },
    "Destination": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份到"
          }
        }
      }
    },
    "Destination folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标文件夹"
          }
        }
      }
    },
    "Destination type": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标类型"
          }
        }
      }
    },
    "Documents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文稿"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Edit Backup Plan": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑备份计划"
          }
        }
      }
    },
    "Edit Plan…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑计划…"
          }
        }
      }
    },
    "Edit “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑“%@”"
          }
        }
      }
    },
    "Encryption password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密密码"
          }
        }
      }
    },
    "Endpoint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务地址"
          }
        }
      }
    },
    "Enter the password of the existing repository. It is checked when you click Next.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入已有仓库的密码。点“下一步”时会进行验证。"
          }
        }
      }
    },
    "Enter the repository password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入现有仓库的密码"
          }
        }
      }
    },
    "Every hour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时"
          }
        }
      }
    },
    "Exclude patterns": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除规则"
          }
        }
      }
    },
    "Existing repository password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有仓库的密码"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件数"
          }
        }
      }
    },
    "Files and folders matching these patterns are skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配这些规则的文件和文件夹将被跳过。"
          }
        }
      }
    },
    "Fill in the remaining S3 fields.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写剩余的 S3 字段后继续"
          }
        }
      }
    },
    "Fill in the remaining SFTP fields.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写剩余的 SFTP 字段后继续"
          }
        }
      }
    },
    "Fix the destination issue shown above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先解决上方提示的目标问题"
          }
        }
      }
    },
    "Folders": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹"
          }
        }
      }
    },
    "For a repository created earlier — by another plan, a previous install, or another Mac. Your password is verified against it; no new repository is created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于之前创建过的备份仓库——比如其他计划、重装系统前或另一台 Mac 留下的。会先验证您输入的密码，不会新建仓库。"
          }
        }
      }
    },
    "Frequency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率"
          }
        }
      }
    },
    "Generate Strong Password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动生成强密码"
          }
        }
      }
    },
    "Host": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机"
          }
        }
      }
    },
    "How often should it run?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多久备份一次？"
          }
        }
      }
    },
    "It runs by itself every day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后每天自动备份"
          }
        }
      }
    },
    "Keelhaven also catches up automatically after your Mac was asleep or off at the scheduled time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果到点时 Mac 正在睡眠或关机，Keelhaven 之后会自动补上这次备份。"
          }
        }
      }
    },
    "Keelhaven automatically copies your important folders to a backup drive, so nothing is lost if your Mac ever breaks or goes missing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelhaven 会自动把您的重要文件夹复制到备份硬盘上。这样即使 Mac 坏了或丢了，文件也不会丢失。"
          }
        }
      }
    },
    "Keelhaven backup status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelhaven 备份状态"
          }
        }
      }
    },
    "Keelhaven is already running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelhaven 已经在运行了"
          }
        }
      }
    },
    "Keelhaven needs restic %@ or newer. Update it with: brew upgrade restic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelhaven 需要 restic %@ 或更新版本。请用以下命令更新：brew upgrade restic"
          }
        }
      }
    },
    "Last backup %@ ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次备份是%@前"
          }
        }
      }
    },
    "Last backup failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次备份失败"
          }
        }
      }
    },
    "Last backup on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次备份于 %@"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        }
      }
    },
    "Loading snapshots…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取备份记录…"
          }
        }
      }
    },
    "Local / External Drive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 / 外置硬盘"
          }
        }
      }
    },
    "Look for its icon in the menu bar at the top right of your screen. Click it to manage your backups.\n\nDon't see the icon? Your menu bar is probably full — on Macs with a notch, macOS hides icons that don't fit. Quit another menu bar app or ⌘-drag an icon off the bar to make room, then relaunch Keelhaven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在屏幕右上角的菜单栏里找它的图标，点击图标即可管理备份。\n\n看不到图标？菜单栏可能已经放满了——在带刘海的 Mac 上，放不下的图标会被系统隐藏。请退出一个其他菜单栏程序，或按住 ⌘ 键把某个图标拖出菜单栏腾出位置，然后重新打开 Keelhaven。"
          }
        }
      }
    },
    "My Backup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的备份"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
